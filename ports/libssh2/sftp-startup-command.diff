@@ -221,6 +221,15 @@
 
 /* SFTP API */
 LIBSSH2_API LIBSSH2_SFTP *libssh2_sftp_init(LIBSSH2_SESSION *session);
+/* ftpflow extension: override how the SFTP service is started on the SSH
+ * channel. By default libssh2 requests the "sftp" subsystem. Callers that
+ * need elevated privileges on the server (e.g. `sudo su -c /usr/libexec/
+ * openssh/sftp-server`) can instead run an arbitrary command via an "exec"
+ * channel request. The pointers are borrowed for the duration of the
+ * libssh2_sftp_init() call and need only stay valid until it returns.
+ * Pass NULL for `command` to restore the default subsystem behaviour. */
+LIBSSH2_API void libssh2_sftp_set_startup_command(LIBSSH2_SESSION *session,
+                                                  const char *command);
 LIBSSH2_API int libssh2_sftp_shutdown(LIBSSH2_SFTP *sftp);
